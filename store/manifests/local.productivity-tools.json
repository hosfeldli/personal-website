{
  "schemaVersion": 2,
  "id": "local.productivity-tools",
  "name": "Productivity Tools",
  "version": "1.0.0",
  "description": "Fast timezone conversion and safe force-quit controls.",
  "pack": "Productivity Tools",
  "category": "Productivity",
  "bundled": false,
  "provenance": "unsigned",
  "trust": "unsigned",
  "capabilities": ["processControl"],
  "commands": [
    {
      "id": "convert-timezones",
      "title": "Convert Timezones",
      "subtitle": "Translate a time between cities in a two-panel view",
      "keywords": ["time", "timezone", "zone", "convert", "utc", "meeting", "world clock"],
      "icon": "globe.americas.fill",
      "action": { "type": "picker", "operation": "timezone" }
    },
    {
      "id": "force-quit-application",
      "title": "Force Quit Application",
      "subtitle": "Choose an unresponsive app and confirm before closing it",
      "keywords": ["force", "quit", "kill", "application", "unresponsive", "frozen"],
      "icon": "xmark.app.fill",
      "action": { "type": "application", "operation": "forceQuit", "target": "picker", "confirmation": true }
    },
    {
      "id": "force-quit-all-applications",
      "title": "Force Quit All Applications",
      "subtitle": "Close every foreground app except Lima after confirmation",
      "keywords": ["force", "quit", "all", "kill", "applications", "unresponsive", "frozen"],
      "icon": "xmark.bin.fill",
      "action": { "type": "application", "operation": "forceQuitAll", "target": "all", "confirmation": true }
    }
  ]
}
