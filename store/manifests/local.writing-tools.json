{
  "schemaVersion": 2,
  "id": "local.writing-tools",
  "name": "Writing Tools",
  "version": "1.4.0",
  "description": "Local plain-text paste plus private rule-based spelling and grammar correction.",
  "pack": "Writing Tools",
  "category": "Writing",
  "bundled": false,
  "provenance": "unsigned",
  "trust": "unsigned",
  "capabilities": ["accessibility", "clipboard", "selectedText"],
  "commands": [
    {
      "id": "paste-plain-text",
      "title": "Paste as Plain Text",
      "subtitle": "Strip formatting from the current clipboard and paste",
      "keywords": ["paste", "plain", "raw", "formatting", "clipboard"],
      "icon": "doc.plaintext",
      "hotkey": "control+option+v",
      "action": { "type": "clipboard", "operation": "pastePlainText" }
    },
    {
      "id": "check-writing",
      "title": "Check Spelling & Grammar",
      "subtitle": "Correct selected text with local Python and Harper rules",
      "keywords": ["spell", "grammar", "writing", "proofread", "correct"],
      "icon": "text.badge.checkmark",
      "hotkey": "control+option+g",
      "action": { "type": "workspace", "operation": "writingReview" }
    }
  ]
}
